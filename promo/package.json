{
  "name": "benchmark-promo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "render:pitch": "remotion render src/index.ts Pitch out/benchmark-pitch-16x9.mp4",
    "render:teaser": "remotion render src/index.ts Teaser out/benchmark-teaser-9x16.mp4",
    "render:demo": "remotion render src/index.ts Demo out/benchmark-demo-16x9.mp4",
