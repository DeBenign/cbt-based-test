PORT=5050
# Use your own Atlas/local connection string. Never commit real credentials.
MONGO_URI=mongodb://127.0.0.1:27017/cbt
JWT_SECRET=replace_with_long_random_string
JWT_EXPIRES_IN=8h
FRONTEND_URL=http://localhost:5173

# AI question generation (teachers: Questions > Generate with AI)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Nomba billing
NOMBA_BASE_URL=https://sandbox.nomba.com
NOMBA_CLIENT_ID=
NOMBA_CLIENT_SECRET=
NOMBA_ACCOUNT_ID=

# Billing: price per student per school term (placeholders -- set your real numbers)
PRICE_PER_STUDENT_PER_TERM=500
MIN_TERM_FEE=15000
TERM_DAYS=120
# Turn on only after the Nomba webhook works; until then schools pay cash and you record it
ONLINE_PAYMENTS_ENABLED=false

# One-time: used only by `npm run seed:superadmin` to create the platform owner login.
# Remove SUPERADMIN_PASSWORD from .env after seeding.
SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
